{
    "name": "stechstudio/laravel-helo-email",
    "description": "Send Laravel mail through Helo's API, with a client for the rest of the Helo API.",
    "keywords": ["laravel", "helo", "helohq", "email", "mail", "transport"],
    "license": "MIT",
    "authors": [
        {
            "name": "Signature Tech Studio",
            "homepage": "https://stechstudio.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/mail": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "STS\\HeloEmail\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "STS\\HeloEmail\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "STS\\HeloEmail\\HeloEmailServiceProvider"
            ],
            "aliases": {
                "Helo": "STS\\HeloEmail\\Facades\\Helo"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
